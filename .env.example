# SilidTrack - Environment Variables (Local Development)
# Copy this file to ".env" (without the .example extension) and fill in real values.
# The bootstrap loader in config/app.php reads this file automatically.

# ---------------------------------------------------------------------------
# PayMongo Payment Gateway
# ---------------------------------------------------------------------------
# Get your test keys from the PayMongo Dashboard: https://dashboard.paymongo.com
# Under "Developers" -> "API keys", copy the Test Mode keys.
#   - Secret Key starts with "sk_test_..."
#   - Public Key starts with "pk_test_..."
#
# These can also be entered (and managed) via the Admin UI:
#   Admin login -> Fees & Payments -> "PayMongo API Keys" section -> Save
# Database values take precedence; environment variables are the fallback.
PAYMONGO_SECRET_KEY=sk_test_
PAYMONGO_PUBLIC_KEY=pk_test_
